{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"trailingComma": "es5",
	"tabWidth": 2,
	"semi": true,
	"singleQuote": true,
	"bracketSameLine": true,
	"bracketSpacing": true,
	"useTabs": true,
	"printWidth": 80,
	"ignorePatterns": [
		"target/**",
		"node_modules/**",
		"package-lock.json",
		"*.rs",
		"*.nix",
		"patches/**",
		"bench/scroll.html"
	]
}
